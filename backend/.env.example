# ============================================================
# TABIBI - BACKEND ENVIRONMENT TEMPLATE (.env.example)
# Dupliquez ce fichier vers 'backend/.env' et renseignez vos valeurs réelles.
# NE COMMETTEZ JAMAIS LE FICHIER '.env' DANS GIT.
# ============================================================

# Configuration Base de Données
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=tabibi_db
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Configuration SMTP / Messagerie (Gmail ou autre serveur SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=votre-email@gmail.com
MAIL_PASS=votre-mot-de-passe-application
MAIL_NAME="Tabibi - طبيبي"

# Configuration URLs Application
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:80
TOKEN_EXPIRY=2592000
