# ==========================================
# TABIBI FRONTEND - CONFIGURATION D'ENVIRONNEMENT (.env.example)
# Dupliquez ce fichier vers 'frontend/.env' pour votre environnement de travail.
# ==========================================

# Identifiant client Google OAuth 2.0 Web
VITE_GOOGLE_CLIENT_ID=votre-google-client-id.apps.googleusercontent.com

# URL de l'API Backend Tabibi
# - Local : http://localhost:8000
# - Production : https://tabibi.dz
# VITE_API_URL=http://localhost:8000
VITE_API_URL=https://tabibi.dz
